# Configuration du validateur Factur-X.
#
# Copiez ce fichier en .env pour un usage local. En production, passez ces valeurs
# par les variables d'environnement du service : ne deposez jamais de secret dans
# le depot.
#
# Toutes les valeurs ci-dessous sont les defauts, sauf mention contraire. Le
# service demarre sans aucune d'elles.

# --------------------------------------------------------------------------
# Service
# --------------------------------------------------------------------------

PORT=8080
# Taille maximale acceptee, en octets. 10 Mo par defaut.
MAX_UPLOAD_BYTES=10485760
# Precompilation des artefacts au demarrage. A laisser actif en production, sans
# quoi la premiere requete paie environ 1,2 seconde de compilation.
WARMUP_ON_STARTUP=1
# Plafond de constats par niveau, pour eviter un rapport illisible sur un fichier
# tres degrade. La troncature est signalee dans le rapport.
MAX_FINDINGS_PER_LEVEL=300
# Origines autorisees, inutile si l'interface est servie par le meme conteneur.
CORS_ORIGINS=

# Emplacements, deja corrects dans l'image Docker.
# RESOURCES_DIR=backend/resources
# STATIC_DIR=backend/static

# --------------------------------------------------------------------------
# Limitation de debit
# --------------------------------------------------------------------------

RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=8
RATE_LIMIT_MAX_TRACKED=20000
# Requetes de validation admises, en traitement comme en attente. Les validations
# s'executent sur un fil unique : ce plafond borne la profondeur de la file.
MAX_CONCURRENT_VALIDATIONS=12
# A METTRE A 1 derriere Cloud Run ou tout autre proxy de confiance, faute de quoi
# tous les appelants partagent un meme plafond. A laisser a 0 sans proxy, sinon
# l'entete X-Forwarded-For devient forgeable et la limitation contournable.
TRUST_PROXY_HEADERS=0

# --------------------------------------------------------------------------
# Compteurs partages
#
# Sans ceci, les quotas repartent de zero a chaque redemarrage et les plafonds de
# debit sont locaux a l'instance. Indispensable pour facturer a l'usage.
# --------------------------------------------------------------------------

# REDIS_URL=rediss://default:MOT_DE_PASSE@hote:6379
REDIS_TIMEOUT_SECONDS=1.5

# --------------------------------------------------------------------------
# Acces par cle
#
# Produire une cle : python scripts/make_api_key.py --id client --plan integration
# Seule l'empreinte figure ici. La cle en clair n'est affichee qu'une fois, a la
# generation, et se transmet au client.
# --------------------------------------------------------------------------

# API_KEYS=[{"id":"acme","label":"ACME Logiciels","plan":"integration","keyHash":"..."}]

# Contact propose dans l'interface pour demander une cle. Vide, aucune demarche
# n'est proposee : mieux vaut ne rien afficher qu'une adresse inexistante.
CONTACT_EMAIL=
CONTACT_URL=

# --------------------------------------------------------------------------
# Manifestations d'interet
#
# Le visiteur peut demander a etre recontacte, sur sa seule initiative et apres
# consentement explicite. Le service ne stocke rien : la demande part vers la
# destination configuree.
#
# La fonction reste inactive, et l'interface ne la propose pas, tant que ces deux
# valeurs ne sont pas renseignees : une destination, et un responsable de
# traitement. On ne recueille pas une adresse sans savoir ou elle va ni dire qui
# la traite.
# --------------------------------------------------------------------------

# LEADS_WEBHOOK_URL=https://votre-crm.example/hooks/facturx
# LEADS_WEBHOOK_TOKEN=jeton-porteur-du-webhook
# A defaut de webhook, empiler dans Redis, a relever par ailleurs.
LEADS_VIA_REDIS=0
LEADS_TIMEOUT_SECONDS=5
# Duree de conservation annoncee au visiteur. Elle engage : la purge est a assurer
# dans le systeme de destination, pas ici.
LEADS_RETENTION_MONTHS=24
# Responsable du traitement, affiche au visiteur. Sans lui, la fonction est inactive.
# LEADS_CONTROLLER=Votre societe, adresse, courriel de contact

# --------------------------------------------------------------------------
# Metriques
#
# Volume traite et repartition des profils sont des donnees commerciales : l'acces
# est ferme tant qu'aucun jeton n'est defini.
# --------------------------------------------------------------------------

# METRICS_TOKEN=un-jeton-long-et-aleatoire

# --------------------------------------------------------------------------
# Audit PDF/A par veraPDF
#
# Desactive par defaut : un appel coute environ 1,5 seconde, presque entierement
# du demarrage de machine virtuelle Java. Utilisez l'image construite avec
# --target service-verapdf, qui renseigne ces valeurs.
# --------------------------------------------------------------------------

VERAPDF_ENABLED=0
# VERAPDF_JAR=/opt/verapdf/bin/cli.jar
JAVA_BIN=java
VERAPDF_TIMEOUT_SECONDS=25
VERAPDF_DEFAULT_FLAVOUR=3b

# --------------------------------------------------------------------------
# Regles France (CTC)
#
# Elles visent le flux entre Plateformes Agreees et produiraient du bruit sur une
# facture examinee hors de ce contexte. Niveau indicatif.
# --------------------------------------------------------------------------

FRCTC_ENABLED=0
